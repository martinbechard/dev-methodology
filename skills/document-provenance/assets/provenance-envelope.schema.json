{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document provenance runtime envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": { "const": 2 },
    "records": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/newRecord" },
          { "$ref": "#/$defs/historicalRecord" }
        ]
      }
    }
  },
  "$defs": {
    "artifactId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{7,199}$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "createdLocal": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?[+-](?:0[0-9]|1[0-4]):[0-5][0-9]$"
    },
    "createdUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "artifactIdEvidence": {
      "enum": [
        "runtime-supplied",
        "retained-task-evidence",
        "retained-rollout-evidence",
        "migration-assigned"
      ]
    },
    "timestampEvidence": {
      "enum": [
        "runtime-supplied",
        "retained-task-evidence",
        "retained-rollout-evidence",
        "git-derived"
      ]
    },
    "dispatchEvidence": {
      "enum": [
        "runtime-supplied",
        "retained-task-evidence",
        "retained-rollout-evidence"
      ]
    },
    "knownTimestampFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Value", "Evidence"],
      "properties": {
        "Value": { "$ref": "#/$defs/nonEmptyString" },
        "Evidence": { "$ref": "#/$defs/timestampEvidence" }
      }
    },
    "knownDispatchFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Value", "Evidence"],
      "properties": {
        "Value": { "$ref": "#/$defs/nonEmptyString" },
        "Evidence": { "$ref": "#/$defs/dispatchEvidence" }
      }
    },
    "newRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Record-Type",
        "Artifact-ID",
        "Created-Local",
        "Created-UTC",
        "Creating-Agent",
        "Runtime",
        "Dispatched-Model",
        "Reasoning-Effort"
      ],
      "properties": {
        "Record-Type": { "const": "new" },
        "Artifact-ID": { "$ref": "#/$defs/artifactId" },
        "Created-Local": { "$ref": "#/$defs/createdLocal" },
        "Created-UTC": { "$ref": "#/$defs/createdUtc" },
        "Creating-Agent": { "$ref": "#/$defs/nonEmptyString" },
        "Runtime": { "$ref": "#/$defs/nonEmptyString" },
        "Dispatched-Model": { "$ref": "#/$defs/nonEmptyString" },
        "Reasoning-Effort": { "$ref": "#/$defs/nonEmptyString" },
        "Task-ID": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "historicalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Record-Type",
        "Artifact-ID",
        "Artifact-ID-Evidence",
        "Known-Facts",
        "Unknown-Facts"
      ],
      "properties": {
        "Record-Type": { "const": "historical" },
        "Artifact-ID": { "$ref": "#/$defs/artifactId" },
        "Artifact-ID-Evidence": { "$ref": "#/$defs/artifactIdEvidence" },
        "Task-ID": { "$ref": "#/$defs/nonEmptyString" },
        "Known-Facts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Created-UTC": { "$ref": "#/$defs/knownTimestampFact" },
            "Created-Local": { "$ref": "#/$defs/knownTimestampFact" },
            "Creating-Agent": { "$ref": "#/$defs/knownDispatchFact" },
            "Runtime": { "$ref": "#/$defs/knownDispatchFact" },
            "Dispatched-Model": { "$ref": "#/$defs/knownDispatchFact" },
            "Reasoning-Effort": { "$ref": "#/$defs/knownDispatchFact" }
          }
        },
        "Unknown-Facts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "Created-UTC",
              "Created-Local",
              "Creating-Agent",
              "Runtime",
              "Dispatched-Model",
              "Reasoning-Effort"
            ]
          }
        }
      }
    }
  }
}
